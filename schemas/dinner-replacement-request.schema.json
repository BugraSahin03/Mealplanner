{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenplanner.local/schemas/dinner-replacement-request.schema.json",
  "title": "Essenplanner Dinner Replacement Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "week", "people", "target", "otherDinners", "excludedDinners", "planningRules"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "week": { "type": "object" },
    "people": { "type": "array", "minItems": 1 },
    "target": { "type": "object" },
    "otherDinners": { "type": "array" },
    "excludedDinners": { "type": "array", "minItems": 1 },
    "planningHistory": { "type": "object" },
    "planningRules": { "type": "object" }
  }
}
