{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenplanner.local/schemas/planner-request.schema.json",
  "title": "Essenplanner Planner Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "week", "people", "planningRules"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "weekStartDate": {
          "type": "string",
          "format": "date"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/requestDay"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "profile.schema.json"
      }
    },
    "planningRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mealsPerDay", "budget"],
      "properties": {
        "mealsPerDay": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["breakfast", "lunch", "dinner", "snack"]
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monthlyBudgetEur": {
              "type": "number",
              "minimum": 0
            },
            "weeklyTargetEur": {
              "type": "number",
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "shoppingMode": {
          "type": "string",
          "enum": ["weekly", "multiple_small_shops", "flex"]
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "globalNotes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "requestDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayId", "weekday", "personContexts"],
      "properties": {
        "dayId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "weekday": {
          "type": "string",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "personContexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["personId", "dayContext"],
            "properties": {
              "personId": {
                "type": "string",
                "enum": ["bugra", "sena"]
              },
              "dayContext": {
                "type": "string",
                "enum": ["office", "home", "away", "flex"]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
