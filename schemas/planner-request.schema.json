{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenplanner.local/schemas/planner-request.schema.json",
  "title": "Essenplanner Planner Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "week", "people", "planningRules"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendarYear", "calendarWeek", "homeOfficeTargets", "days"],
      "properties": {
        "weekStartDate": {
          "type": "string",
          "format": "date"
        },
        "calendarYear": {
          "type": "integer",
          "minimum": 2000
        },
        "calendarWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53
        },
        "homeOfficeTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bugra", "sena"],
          "properties": {
            "bugra": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "sena": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/requestDay"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "profile.schema.json"
      }
    },
    "planningHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latestWeeks"],
      "properties": {
        "latestWeeks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/historyWeek"
          }
        }
      }
    },
    "planningRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mealsPerDay", "budget", "lunchBatchPrep", "dinnerLeftoverPlanning"],
      "properties": {
        "mealsPerDay": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["breakfast", "lunch", "dinner", "snack"]
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monthlyBudgetEur": {
              "type": "number",
              "minimum": 0
            },
            "weeklyTargetEur": {
              "type": "number",
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "lunchBatchPrep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "weekdayDishCount", "weekdays"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "weekdayDishCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "enum": ["monday", "tuesday", "wednesday", "thursday", "friday"]
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "dinnerLeftoverPlanning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "defaultDinnerSpanDays"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "defaultDinnerSpanDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "shoppingMode": {
          "type": "string",
          "enum": ["weekly", "multiple_small_shops", "flex"]
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "globalNotes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "historyMeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "normalizedTitle", "people", "coreIngredients"],
      "properties": {
        "title": { "type": "string" },
        "normalizedTitle": { "type": "string" },
        "people": {
          "type": "array",
          "items": { "type": "string", "enum": ["bugra", "sena"] }
        },
        "coreIngredients": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "proteinSource": { "type": "string" }
      }
    },
    "historyWeek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekId", "calendarYear", "calendarWeek", "meals"],
      "properties": {
        "weekId": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "calendarYear": { "type": "integer", "minimum": 2000 },
        "calendarWeek": { "type": "integer", "minimum": 1, "maximum": 53 },
        "meals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["breakfast", "lunch", "dinner"],
          "properties": {
            "breakfast": { "type": "array", "items": { "$ref": "#/$defs/historyMeal" } },
            "lunch": { "type": "array", "items": { "$ref": "#/$defs/historyMeal" } },
            "dinner": { "type": "array", "items": { "$ref": "#/$defs/historyMeal" } }
          }
        }
      }
    },
    "requestDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayId", "weekday", "personContexts"],
      "properties": {
        "dayId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "weekday": {
          "type": "string",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "personContexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["personId", "dayContext"],
            "properties": {
              "personId": {
                "type": "string",
                "enum": ["bugra", "sena"]
              },
              "dayContext": {
                "type": "string",
                "enum": ["office", "home", "away", "flex"]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
