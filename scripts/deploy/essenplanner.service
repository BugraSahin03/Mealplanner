[Unit]
Description=Essenplanner production service
Documentation=https://github.com/BugraSahin03/Essensplan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=essenplanner
Group=essenplanner
WorkingDirectory=/opt/essenplanner
Environment=NODE_ENV=production
Environment=ESSENPLANNER_DB_PATH=/var/lib/essenplanner/essenplanner.db
Environment=ESSENPLANNER_PLANNER_ADAPTER=fixture
Environment=PORT=3008
Environment=NPM_CONFIG_CACHE=/var/lib/essenplanner/npm-cache
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3008
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/essenplanner /var/backups/essenplanner /opt/essenplanner

[Install]
WantedBy=multi-user.target
