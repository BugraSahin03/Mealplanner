{
  "name": "essenplanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude '**/._*'",
    "test:watch": "vitest --exclude '**/._*'",
    "check": "npm run lint && npm run test && npm run build && npm run check:schema",
    "check:schema": "npm run validate:planner-request -- fixtures/planner-request.sample.json fixtures/planner-request.week.sample.json && npm run build:planner-test-prompt -- fixtures/planner-request.sample.json > /tmp/essenplanner-planner-test-prompt.md",
    "check:openclaw-runtime": "node scripts/check-openclaw-runtime.mjs",
    "build:planner-test-prompt": "node scripts/build-planner-test-prompt.mjs",
    "validate:planner-request": "node scripts/validate-planner-request.mjs",
    "validate:planner-response": "node scripts/validate-openclaw-planner-response.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "^8.5.16"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5",
    "vitest": "^4.0.7"
  }
}
